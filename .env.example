# Másold .env néven, vagy add meg környezeti változóként a tárhelyen.
PORT=3000

# Admin belépés (/mzm-admin). Ha az ADMIN_PASSWORD nincs megadva, az első
# induláskor generálunk egy véletlen jelszót a data/admin.json fájlba
# (hash-elve) és egyszer kiírjuk a konzolra.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Munkamenet-aláíró titok (min. 32 karakter). Ha üres, a data/secret.json-ban generáljuk.
SESSION_SECRET=

# HTTPS mögött (proxy/CDN) állítsd 1-re, hogy a cookie Secure legyen és az X-Forwarded-For fejlécből jöjjön az IP.
TRUST_PROXY=0

# Az adatok helye (események, titkok)
DATA_DIR=./data
